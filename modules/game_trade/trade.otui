TradeGoldButton < UIButton
  height: 26
  font: verdana-11px-antialised
  color: #1a1200
  background-color: #f2c400
  border-width: 1
  border-color: #ffe27a

  $hover:
    background-color: #ffd633

  $disabled:
    color: #6f86a8
    background-color: #101f3e
    border-color: #24415f

TradeGreenButton < UIButton
  height: 26
  font: verdana-11px-antialised
  color: #0a1320
  background-color: #5fd35f
  border-width: 1
  border-color: #a6f0a6

  $hover:
    background-color: #7ee57e

  $disabled:
    color: #6f86a8
    background-color: #101f3e
    border-color: #24415f

TradeDarkButton < UIButton
  height: 26
  font: verdana-11px-antialised
  color: #dce8f5
  background-color: #101f3e
  border-width: 1
  border-color: #24415f

  $hover:
    color: #ffffff
    background-color: #7a1f1f
    border-color: #e04848

TradeTab < UIButton
  size: 110 28
  font: verdana-11px-antialised
  color: #dce8f5
  background-color: #101f3e
  border-width: 1
  border-color: #24415f

  $hover:
    color: #ffffff
    background-color: #1a3058

TradeEdit < TextEdit
  height: 22
  font: verdana-11px-antialised
  color: #0a1320
  background-color: #c8c8c8
  selection-color: #ffffff
  selection-background-color: #2b5a8a

TradeCard < UIWidget
  size: 122 140
  background-color: #0c1828
  border-width: 1
  border-color: #1d3557

  UIWidget
    id: iconBg
    size: 42 42
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 7
    background-color: #07101c
    border-width: 1
    border-color: #1d3557
    phantom: true

  UIItem
    id: item
    size: 32 32
    anchors.centerIn: iconBg
    virtual: true
    phantom: true

  UIWidget
    id: portrait
    size: 38 38
    anchors.centerIn: iconBg
    image-size: 38 38
    visible: false
    phantom: true

  Label
    id: name
    anchors.top: iconBg.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    margin-left: 4
    margin-right: 4
    height: 28
    text-wrap: true
    text-align: center
    font: verdana-11px-rounded
    color: #ffffff
    phantom: true

  Label
    id: sub
    anchors.top: name.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 14
    text-align: center
    font: verdana-11px-rounded
    color: #8fa7c4
    phantom: true

  TextEdit
    id: qty
    size: 40 22
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-left: 6
    margin-bottom: 6
    text-align: center
    font: verdana-11px-antialised
    color: #0a1320
    background-color: #c8c8c8
    selection-color: #ffffff
    selection-background-color: #2b5a8a

  UIButton
    id: addButton
    height: 22
    anchors.left: qty.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 4
    margin-right: 6
    margin-bottom: 6
    font: verdana-11px-antialised
    color: #1a1200
    background-color: #f2c400
    border-width: 1
    border-color: #ffe27a

    $hover:
      background-color: #ffd633

    $disabled:
      color: #6f86a8
      background-color: #101f3e
      border-color: #24415f

TradeRow < UIWidget
  height: 40
  background-color: #0c1828
  border-width: 1
  border-color: #1d3557

  UIWidget
    id: iconBg
    size: 34 34
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    background-color: #07101c
    border-width: 1
    border-color: #1d3557
    phantom: true

  UIItem
    id: item
    size: 32 32
    anchors.centerIn: iconBg
    virtual: true
    phantom: true

  UIWidget
    id: portrait
    size: 32 32
    anchors.centerIn: iconBg
    image-size: 32 32
    visible: false
    phantom: true

  UIButton
    id: removeButton
    text: X
    size: 22 22
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    font: verdana-11px-antialised
    color: #dce8f5
    background-color: #101f3e
    border-width: 1
    border-color: #24415f

    $hover:
      color: #ffffff
      background-color: #7a1f1f
      border-color: #e04848

  Label
    id: name
    anchors.top: parent.top
    anchors.left: iconBg.right
    anchors.right: parent.right
    margin-top: 5
    margin-left: 8
    margin-right: 34
    height: 14
    font: verdana-11px-rounded
    color: #ffffff
    phantom: true

  Label
    id: sub
    anchors.top: name.bottom
    anchors.left: name.left
    anchors.right: name.right
    margin-top: 2
    height: 14
    font: verdana-11px-rounded
    color: #8fa7c4
    phantom: true

TradeStatus < Label
  height: 20
  width: 96
  text-align: center
  font: verdana-11px-antialised
  color: #dce8f5
  background-color: #101f3e
  border-width: 1
  border-color: #24415f

TradeInvite < UIWindow
  size: 340 150
  anchors.top: parent.top
  anchors.horizontalCenter: parent.horizontalCenter
  margin-top: 120
  background-color: #0a1320
  border-width: 1
  border-color: #f2c400
  focusable: true

  UIWidget
    id: inviteBar
    size: 4 18
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 14
    margin-left: 16
    background-color: #f2c400
    phantom: true

  Label
    id: inviteTitle
    text: PEDIDO DE TROCA
    anchors.verticalCenter: inviteBar.verticalCenter
    anchors.left: inviteBar.right
    margin-left: 8
    font: verdana-11px-antialised
    color: #f2c400
    text-auto-resize: true
    phantom: true

  Label
    id: inviteText
    anchors.top: inviteBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 14
    margin-left: 16
    margin-right: 16
    height: 30
    text-wrap: true
    text-align: center
    font: verdana-11px-antialised
    color: #dce8f5
    phantom: true

  Label
    id: inviteTime
    anchors.top: inviteText.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 14
    text-align: center
    font: verdana-11px-rounded
    color: #6f86a8
    phantom: true

  TradeGreenButton
    id: acceptInvite
    text: Aceitar
    width: 140
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 14
    margin-left: 22

  TradeDarkButton
    id: refuseInvite
    text: Recusar
    width: 140
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 14
    margin-right: 22

UIWindow
  id: tradeWindow
  size: 980 600
  anchors.centerIn: parent
  background-color: #0a1320
  border-width: 1
  border-color: #f2c400
  focusable: true
  visible: false

  UIWidget
    id: headerBar
    size: 4 18
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 14
    margin-left: 16
    background-color: #f2c400
    phantom: true

  Label
    id: titleLabel
    text: TROCA
    anchors.verticalCenter: headerBar.verticalCenter
    anchors.left: headerBar.right
    margin-left: 8
    font: verdana-11px-antialised
    color: #f2c400
    text-auto-resize: true
    phantom: true

  Label
    id: subtitleLabel
    anchors.verticalCenter: headerBar.verticalCenter
    anchors.left: titleLabel.right
    margin-left: 14
    font: verdana-11px-antialised
    color: #8fa7c4
    text-auto-resize: true
    phantom: true

  UIButton
    id: closeButton
    text: X
    size: 24 22
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 12
    margin-right: 14
    font: verdana-11px-antialised
    color: #dce8f5
    background-color: #101f3e
    border-width: 1
    border-color: #24415f

    $hover:
      color: #ffffff
      background-color: #7a1f1f
      border-color: #e04848

  UIWidget
    id: pickerPanel
    width: 412
    anchors.top: headerBar.bottom
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 14
    margin-left: 16
    margin-bottom: 16
    background-color: #0c1828
    border-width: 1
    border-color: #1d3557

  TradeTab
    id: tabBAG
    text: Mochila
    anchors.top: pickerPanel.top
    anchors.left: pickerPanel.left
    margin-top: 10
    margin-left: 10

  TradeTab
    id: tabTEAM
    text: Equipe
    anchors.top: tabBAG.top
    anchors.left: tabBAG.right
    margin-left: 6

  TradeEdit
    id: searchEdit
    width: 90
    anchors.verticalCenter: tabBAG.verticalCenter
    anchors.right: searchButton.left
    margin-right: 4

  UIButton
    id: searchButton
    text: Buscar
    size: 52 22
    anchors.verticalCenter: tabBAG.verticalCenter
    anchors.right: pickerPanel.right
    margin-right: 10
    font: verdana-11px-antialised
    color: #dce8f5
    background-color: #101f3e
    border-width: 1
    border-color: #24415f

    $hover:
      color: #ffffff
      background-color: #1a3058

  Label
    id: listHint
    anchors.top: tabBAG.bottom
    anchors.left: pickerPanel.left
    anchors.right: pickerPanel.right
    margin-top: 8
    margin-left: 10
    margin-right: 10
    height: 14
    font: verdana-11px-antialised
    color: #8fa7c4

  ScrollablePanel
    id: grid
    anchors.top: listHint.bottom
    anchors.left: pickerPanel.left
    anchors.right: gridScroll.left
    anchors.bottom: pickerPanel.bottom
    margin-top: 8
    margin-left: 10
    margin-right: 4
    margin-bottom: 10
    vertical-scrollbar: gridScroll
    layout:
      type: grid
      cell-size: 122 140
      cell-spacing: 6
      num-columns: 3
      flow: true

  VerticalScrollBar
    id: gridScroll
    width: 12
    anchors.top: listHint.bottom
    anchors.bottom: pickerPanel.bottom
    anchors.right: pickerPanel.right
    margin-top: 8
    margin-bottom: 10
    margin-right: 8
    step: 73
    pixels-scroll: true

  UIWidget
    id: myPanel
    width: 256
    anchors.top: pickerPanel.top
    anchors.left: pickerPanel.right
    anchors.bottom: footerPanel.top
    margin-left: 12
    margin-bottom: 10
    background-color: #0c1828
    border-width: 1
    border-color: #1d3557

  UIWidget
    id: theirPanel
    anchors.top: pickerPanel.top
    anchors.left: myPanel.right
    anchors.right: parent.right
    anchors.bottom: footerPanel.top
    margin-left: 10
    margin-right: 16
    margin-bottom: 10
    background-color: #0c1828
    border-width: 1
    border-color: #1d3557

  Label
    id: myTitle
    text: SUA OFERTA
    anchors.top: myPanel.top
    anchors.left: myPanel.left
    margin-top: 12
    margin-left: 10
    font: verdana-11px-antialised
    color: #f2c400
    text-auto-resize: true

  TradeStatus
    id: myStatus
    anchors.verticalCenter: myTitle.verticalCenter
    anchors.right: myPanel.right
    margin-right: 8

  Label
    id: myCount
    anchors.top: myTitle.bottom
    anchors.left: myPanel.left
    anchors.right: myPanel.right
    margin-top: 8
    margin-left: 10
    margin-right: 10
    height: 14
    font: verdana-11px-rounded
    color: #6f86a8

  ScrollablePanel
    id: myList
    anchors.top: myCount.bottom
    anchors.left: myPanel.left
    anchors.right: myScroll.left
    anchors.bottom: myPanel.bottom
    margin-top: 6
    margin-left: 8
    margin-right: 3
    margin-bottom: 8
    vertical-scrollbar: myScroll
    layout:
      type: verticalBox
      spacing: 4

  VerticalScrollBar
    id: myScroll
    width: 10
    anchors.top: myCount.bottom
    anchors.bottom: myPanel.bottom
    anchors.right: myPanel.right
    margin-top: 6
    margin-bottom: 8
    margin-right: 6
    step: 44
    pixels-scroll: true

  Label
    id: theirTitle
    text: OFERTA DELE
    anchors.top: theirPanel.top
    anchors.left: theirPanel.left
    anchors.right: theirStatus.left
    margin-top: 12
    margin-left: 10
    margin-right: 6
    height: 14
    font: verdana-11px-antialised
    color: #f2c400

  TradeStatus
    id: theirStatus
    anchors.top: theirPanel.top
    anchors.right: theirPanel.right
    margin-top: 9
    margin-right: 8

  Label
    id: theirCount
    anchors.top: theirTitle.bottom
    anchors.left: theirPanel.left
    anchors.right: theirPanel.right
    margin-top: 8
    margin-left: 10
    margin-right: 10
    height: 14
    font: verdana-11px-rounded
    color: #6f86a8

  ScrollablePanel
    id: theirList
    anchors.top: theirCount.bottom
    anchors.left: theirPanel.left
    anchors.right: theirScroll.left
    anchors.bottom: theirPanel.bottom
    margin-top: 6
    margin-left: 8
    margin-right: 3
    margin-bottom: 8
    vertical-scrollbar: theirScroll
    layout:
      type: verticalBox
      spacing: 4

  VerticalScrollBar
    id: theirScroll
    width: 10
    anchors.top: theirCount.bottom
    anchors.bottom: theirPanel.bottom
    anchors.right: theirPanel.right
    margin-top: 6
    margin-bottom: 8
    margin-right: 6
    step: 44
    pixels-scroll: true

  UIWidget
    id: footerPanel
    height: 76
    anchors.left: pickerPanel.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 12
    margin-right: 16
    margin-bottom: 16
    background-color: #0c1828
    border-width: 1
    border-color: #1d3557

  Label
    id: stageLabel
    anchors.top: footerPanel.top
    anchors.left: footerPanel.left
    anchors.right: footerPanel.right
    margin-top: 9
    margin-left: 12
    margin-right: 12
    height: 14
    text-align: center
    font: verdana-11px-antialised
    color: #dce8f5

  TradeGoldButton
    id: readyButton
    text: Pronto
    width: 150
    anchors.bottom: footerPanel.bottom
    anchors.left: footerPanel.left
    margin-bottom: 10
    margin-left: 12

  TradeGreenButton
    id: confirmButton
    text: Confirmar troca
    anchors.bottom: footerPanel.bottom
    anchors.left: readyButton.right
    anchors.right: cancelButton.left
    margin-bottom: 10
    margin-left: 10
    margin-right: 10

  TradeDarkButton
    id: cancelButton
    text: Cancelar
    width: 120
    anchors.bottom: footerPanel.bottom
    anchors.right: footerPanel.right
    margin-bottom: 10
    margin-right: 12
