MsLabel < Label
  font: verdana-11px-rounded
  color: #dce8f5
  phantom: true

MsButton < UIButton
  height: 26
  font: verdana-11px-rounded
  color: #dce8f5
  background-color: #101f3e
  border-width: 1
  border-color: #24415f

  $hover:
    color: #ffffff
    border-color: #f2c400

  $disabled:
    color: #5f7596
    background-color: #0c1828
    border-color: #1d3557

MsActionButton < UIButton
  height: 26
  font: verdana-11px-antialised
  color: #0a1320
  background-color: #5fd35f
  border-width: 1
  border-color: #9cf09c

  $hover:
    background-color: #7fe57f

  $disabled:
    color: #5f7596
    background-color: #0c1828
    border-color: #1d3557

MsTab < UIButton
  size: 140 28
  font: verdana-11px-antialised
  color: #dce8f5
  background-color: #101f3e
  border-width: 1
  border-color: #24415f

MsCard < UIWidget
  height: 112
  background-color: #0c1828
  border-width: 1
  border-color: #1d3557

  UIWidget
    id: accent
    width: 6
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    background-color: #5fd35f
    phantom: true

  UIWidget
    id: slotBg
    size: 48 48
    anchors.left: accent.right
    anchors.top: parent.top
    margin-left: 12
    margin-top: 14
    background-color: #07101c
    border-width: 1
    border-color: #1d3557
    phantom: true

  UIItem
    id: icon
    size: 32 32
    anchors.centerIn: slotBg
    virtual: true
    phantom: true

  Label
    id: diffLabel
    width: 64
    height: 16
    anchors.top: slotBg.bottom
    anchors.horizontalCenter: slotBg.horizontalCenter
    margin-top: 8
    text-align: center
    font: verdana-11px-antialised
    color: #0a1320
    background-color: #5fd35f
    phantom: true

  MsButton
    id: rerollButton
    width: 120
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 12
    margin-bottom: 12
    text: Trocar missao

  MsActionButton
    id: claimButton
    width: 120
    anchors.right: parent.right
    anchors.top: parent.top
    margin-right: 12
    margin-top: 14
    text: Resgatar

  MsActionButton
    id: deliverButton
    width: 120
    anchors.right: parent.right
    anchors.top: claimButton.bottom
    margin-right: 12
    margin-top: 6
    text: Entregar
    color: #0a1320
    background-color: #f2c400
    border-color: #ffe27a

    $hover:
      background-color: #ffd633

  MsLabel
    id: description
    height: 16
    anchors.top: slotBg.top
    anchors.left: slotBg.right
    anchors.right: claimButton.left
    margin-left: 14
    margin-right: 14
    color: #ffffff

  MsLabel
    id: kindLabel
    height: 14
    anchors.top: description.bottom
    anchors.left: description.left
    anchors.right: description.right
    margin-top: 4
    color: #8fa7c4

  UIWidget
    id: track
    height: 18
    anchors.top: kindLabel.bottom
    anchors.left: description.left
    anchors.right: description.right
    margin-top: 8
    background-color: #07101c
    border-width: 1
    border-color: #1d3557
    phantom: true

  UIWidget
    id: fill
    width: 0
    anchors.top: track.top
    anchors.bottom: track.bottom
    anchors.left: track.left
    margin: 1
    background-color: #2e7d4a
    phantom: true

  MsLabel
    id: progressLabel
    anchors.fill: track
    text-align: center
    color: #ffffff

  MsLabel
    id: rewardLabel
    height: 14
    anchors.top: track.bottom
    anchors.left: description.left
    anchors.right: description.right
    margin-top: 8
    color: #f2c400

MsShopRow < UIWidget
  height: 46
  background-color: #0c1828
  border-width: 1
  border-color: #1d3557

  UIWidget
    id: slotBg
    size: 38 38
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    background-color: #07101c
    border-width: 1
    border-color: #1d3557
    phantom: true

  UIItem
    id: item
    size: 32 32
    anchors.centerIn: slotBg
    virtual: true
    phantom: true

  MsActionButton
    id: buyButton
    width: 90
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    text: Trocar

  TextEdit
    id: qty
    width: 46
    height: 22
    anchors.right: buyButton.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    text: 1
    max-length: 3
    font: verdana-11px-antialised
    color: #0a1320
    background-color: #a2a2a2
    border-width: 1
    border-color: #24415f

  MsLabel
    id: price
    width: 90
    anchors.right: qty.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 10
    text-align: right
    color: #f2c400

  MsLabel
    id: name
    height: 16
    anchors.left: slotBg.right
    anchors.right: price.left
    anchors.top: parent.top
    margin-left: 10
    margin-top: 7
    color: #ffffff

  MsLabel
    id: sub
    height: 14
    anchors.left: name.left
    anchors.right: name.right
    anchors.top: name.bottom
    margin-top: 2
    color: #8fa7c4

UIWindow
  id: missionsWindow
  size: 720 560
  anchors.centerIn: parent
  background-color: #0a1320
  border-width: 1
  border-color: #f2c400
  focusable: true
  visible: false
  draggable: true

  MsLabel
    id: titleLabel
    text: MISSOES DIARIAS
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 14
    margin-left: 18
    color: #f2c400
    text-auto-resize: true

  MsLabel
    id: subtitleLabel
    anchors.top: titleLabel.bottom
    anchors.left: titleLabel.left
    margin-top: 4
    color: #8fa7c4
    text-auto-resize: true

  UIButton
    id: closeButton
    text: X
    size: 22 20
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 12
    margin-right: 14
    font: verdana-11px-rounded
    color: #dce8f5
    background-color: #101f3e
    border-width: 1
    border-color: #24415f

    $hover:
      color: #ffffff
      background-color: #7a1f1f
      border-color: #e04848

  UIWidget
    id: pointsBox
    size: 170 34
    anchors.top: parent.top
    anchors.right: closeButton.left
    margin-top: 10
    margin-right: 12
    background-color: #101f3e
    border-width: 1
    border-color: #6b5a10
    phantom: true

  MsLabel
    id: pointsLabel
    anchors.centerIn: pointsBox
    color: #f2c400
    text-auto-resize: true

  MsTab
    id: tabMissions
    text: Missoes
    anchors.top: subtitleLabel.bottom
    anchors.left: parent.left
    margin-top: 14
    margin-left: 18

  MsTab
    id: tabShop
    text: Loja de pontos
    anchors.top: tabMissions.top
    anchors.left: tabMissions.right
    margin-left: 6

  MsLabel
    id: timerLabel
    anchors.verticalCenter: tabMissions.verticalCenter
    anchors.right: parent.right
    margin-right: 18
    color: #8fa7c4
    text-auto-resize: true

  UIWidget
    id: tabLine
    height: 1
    anchors.top: tabMissions.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 18
    margin-right: 18
    background-color: #24415f
    phantom: true

  Panel
    id: missionsPage
    anchors.top: tabLine.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 12 18 14 18

    Panel
      id: cards
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 348
      layout:
        type: verticalBox
        spacing: 6

    UIWidget
      id: bonusBox
      anchors.top: cards.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 10
      background-color: #15120a
      border-width: 1
      border-color: #6b5a10

    MsActionButton
      id: bonusButton
      size: 160 32
      anchors.right: bonusBox.right
      anchors.verticalCenter: bonusBox.verticalCenter
      margin-right: 12
      text: Resgatar bonus
      color: #0a1320
      background-color: #f2c400
      border-color: #ffe27a

      $hover:
        background-color: #ffd633

    MsLabel
      id: bonusTitle
      height: 16
      anchors.top: bonusBox.top
      anchors.left: bonusBox.left
      anchors.right: bonusButton.left
      margin-top: 12
      margin-left: 14
      margin-right: 12
      color: #f2c400
      text: BONUS DO DIA

    MsLabel
      id: bonusLabel
      height: 14
      anchors.top: bonusTitle.bottom
      anchors.left: bonusTitle.left
      anchors.right: bonusTitle.right
      margin-top: 4
      color: #dce8f5

    MsLabel
      id: rerollLabel
      height: 14
      anchors.top: bonusLabel.bottom
      anchors.left: bonusTitle.left
      anchors.right: bonusTitle.right
      margin-top: 4
      color: #8fa7c4

  Panel
    id: shopPage
    anchors.top: tabLine.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 12 18 14 18
    visible: false

    MsLabel
      id: shopHint
      height: 14
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      color: #8fa7c4
      text: Troque seus pontos de missao por itens. Os itens vao para a mochila (ou PC, se estiver cheia).

    VerticalScrollBar
      id: shopScroll
      anchors.top: shopHint.bottom
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-top: 8
      step: 48
      pixels-scroll: true

    ScrollablePanel
      id: shopList
      anchors.top: shopHint.bottom
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: shopScroll.left
      margin-top: 8
      margin-right: 4
      vertical-scrollbar: shopScroll
      layout:
        type: verticalBox
        spacing: 4
