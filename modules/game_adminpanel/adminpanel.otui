AdmButton < UIButton
  height: 22
  font: verdana-11px-antialised
  color: #dce8f5
  background-color: #101f3e
  border-width: 1
  border-color: #24415f

  $hover:
    color: #ffffff
    background-color: #1a3058

  $on:
    color: #1a1200
    background-color: #f2c400
    border-color: #ffe27a

  $disabled:
    color: #4a5f7a

AdmGold < UIButton
  height: 24
  font: verdana-11px-antialised
  color: #1a1200
  background-color: #f2c400
  border-width: 1
  border-color: #ffe27a

  $hover:
    background-color: #ffd633

  $disabled:
    color: #6f86a8
    background-color: #101f3e
    border-color: #24415f

AdmGreen < UIButton
  height: 24
  font: verdana-11px-antialised
  color: #0a1320
  background-color: #5fd35f
  border-width: 1
  border-color: #a6f0a6

  $hover:
    background-color: #7ee57e

AdmRed < UIButton
  height: 24
  font: verdana-11px-antialised
  color: #ffffff
  background-color: #a32d2d
  border-width: 1
  border-color: #e04848

  $hover:
    background-color: #c23a3a

AdmTab < UIButton
  height: 30
  font: verdana-11px-antialised
  color: #8fa7c4
  text-align: left
  text-offset: 12 0
  background-color: #0c1828
  border-width: 1
  border-color: #1d3557

  $hover:
    color: #ffffff
    background-color: #142a4a

  $on:
    color: #1a1200
    background-color: #f2c400
    border-color: #ffe27a

AdmEdit < TextEdit
  height: 22
  font: verdana-11px-antialised
  color: #0a1320
  background-color: #a2a2a2
  selection-color: #ffffff
  selection-background-color: #2b5a8a

AdmLabel < Label
  font: verdana-11px-rounded
  color: #8fa7c4
  text-auto-resize: true

AdmTitle < Label
  font: verdana-11px-antialised
  color: #f2c400
  text-auto-resize: true

AdmBox < UIWidget
  background-color: #0c1828
  border-width: 1
  border-color: #1d3557

AdmPlayerRow < UIButton
  height: 36
  background-color: #0c1828
  border-width: 1
  border-color: #1d3557

  $hover:
    background-color: #142a4a

  $on:
    background-color: #263b59
    border-color: #f2c400

  Label
    id: name
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 8
    margin-top: 4
    width: 150
    font: verdana-11px-antialised
    color: #dce8f5
    phantom: true

  Label
    id: ids
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-left: 8
    margin-bottom: 4
    width: 150
    font: verdana-11px-rounded
    color: #f2c400
    phantom: true

  Label
    id: info
    anchors.left: name.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    font: verdana-11px-rounded
    color: #6f86a8
    phantom: true

AdmItemRow < UIButton
  height: 40
  background-color: #0c1828
  border-width: 1
  border-color: #1d3557

  $hover:
    background-color: #142a4a

  $on:
    background-color: #263b59
    border-color: #f2c400

  UIItem
    id: item
    size: 32 32
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    virtual: true
    phantom: true

  Label
    id: name
    anchors.left: item.right
    anchors.right: id.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    font: verdana-11px-antialised
    color: #dce8f5
    phantom: true

  Label
    id: id
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    width: 60
    margin-right: 8
    text-align: right
    font: verdana-11px-rounded
    color: #6f86a8
    phantom: true

AdmStatRow < UIWidget
  height: 22

  Label
    id: statName
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 84
    margin-left: 12
    font: verdana-11px-rounded
    color: #dce8f5
    phantom: true

  AdmEdit
    id: iv
    anchors.left: statName.right
    anchors.verticalCenter: parent.verticalCenter
    width: 56
    margin-left: 6

  AdmEdit
    id: ev
    anchors.left: iv.right
    anchors.verticalCenter: parent.verticalCenter
    width: 56
    margin-left: 6

  AdmEdit
    id: bonus
    anchors.left: ev.right
    anchors.verticalCenter: parent.verticalCenter
    width: 56
    margin-left: 6

AdmMonRow < UIButton
  height: 44
  background-color: #0c1828
  border-width: 1
  border-color: #1d3557

  $hover:
    background-color: #142a4a

  $on:
    background-color: #263b59
    border-color: #f2c400

  UICreature
    id: creature
    size: 40 40
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    phantom: true

  Label
    id: name
    anchors.left: creature.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    font: verdana-11px-antialised
    color: #dce8f5
    phantom: true

AdmFavRow < UIWidget
  height: 26
  background-color: #0c1828
  border-width: 1
  border-color: #1d3557

  Label
    id: name
    anchors.left: parent.left
    anchors.right: goButton.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    margin-right: 6
    font: verdana-11px-rounded
    color: #dce8f5

  AdmButton
    id: removeButton
    text: x
    size: 22 20
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3

  AdmButton
    id: goButton
    text: Ir
    size: 40 20
    anchors.right: removeButton.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3

AdmRateRow < UIWidget
  height: 26

  Label
    id: name
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 90
    font: verdana-11px-rounded
    color: #dce8f5

  AdmEdit
    id: value
    anchors.left: name.right
    anchors.verticalCenter: parent.verticalCenter
    width: 60

  AdmButton
    id: applyButton
    text: Aplicar
    anchors.left: value.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    width: 62

AdmStaffRow < UIButton
  height: 30
  background-color: #0c1828
  border-width: 1
  border-color: #1d3557

  $hover:
    background-color: #142a4a

  $on:
    background-color: #263b59
    border-color: #f2c400

  UIWidget
    id: dot
    size: 8 8
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    background-color: #4a5f7a
    phantom: true

  Label
    id: name
    anchors.left: dot.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    width: 150
    font: verdana-11px-antialised
    color: #dce8f5
    phantom: true

  Label
    id: role
    anchors.left: name.right
    anchors.verticalCenter: parent.verticalCenter
    width: 90
    font: verdana-11px-antialised
    color: #f2c400
    phantom: true

  Label
    id: info
    anchors.left: role.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    text-align: right
    font: verdana-11px-rounded
    color: #6f86a8
    phantom: true

AdmEditStatRow < UIWidget
  height: 22

  Label
    id: statName
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 92
    margin-left: 12
    font: verdana-11px-rounded
    color: #dce8f5
    phantom: true

  AdmEdit
    id: iv
    anchors.left: statName.right
    anchors.verticalCenter: parent.verticalCenter
    width: 54

  AdmEdit
    id: ev
    anchors.left: iv.right
    anchors.verticalCenter: parent.verticalCenter
    width: 54
    margin-left: 6

  AdmEdit
    id: vit
    anchors.left: ev.right
    anchors.verticalCenter: parent.verticalCenter
    width: 54
    margin-left: 6

  AdmEdit
    id: bonus
    anchors.left: vit.right
    anchors.verticalCenter: parent.verticalCenter
