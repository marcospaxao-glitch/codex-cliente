    margin-left: 6

AdmCastleRow < UIButton
  height: 38
  background-color: #0c1828
  border-width: 1
  border-color: #1d3557

  $hover:
    background-color: #142a4a

  $on:
    background-color: #263b59
    border-color: #f2c400

  Label
    id: name
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin: 4 8 0 8
    font: verdana-11px-antialised
    color: #dce8f5
    phantom: true

  Label
    id: info
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 0 8 4 8
    font: verdana-11px-rounded
    color: #6f86a8
    phantom: true

UIWindow
  id: adminWindow
  size: 900 580
  anchors.centerIn: parent
  background-color: #0a1320
  border-width: 1
  border-color: #f2c400
  focusable: true
  visible: false

  UIWidget
    id: headerBar
    size: 4 18
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 14
    margin-left: 16
    background-color: #f2c400
    phantom: true

  Label
    id: titleLabel
    text: PAINEL ADM
    anchors.verticalCenter: headerBar.verticalCenter
    anchors.left: headerBar.right
    margin-left: 8
    font: verdana-11px-antialised
    color: #f2c400
    text-auto-resize: true
    phantom: true

  Label
    id: whoLabel
    anchors.verticalCenter: headerBar.verticalCenter
    anchors.left: titleLabel.right
    margin-left: 14
    font: verdana-11px-rounded
    color: #8fa7c4
    text-auto-resize: true
    phantom: true

  Label
    id: statusLabel
    anchors.verticalCenter: headerBar.verticalCenter
    anchors.left: whoLabel.right
    anchors.right: closeButton.left
    margin-left: 20
    margin-right: 10
    font: verdana-11px-antialised
    color: #5fd35f
    text-align: right

  UIButton
    id: closeButton
    text: X
    size: 24 22
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 12
    margin-right: 14
    font: verdana-11px-antialised
    color: #dce8f5
    background-color: #101f3e
    border-width: 1
    border-color: #24415f

    $hover:
      color: #ffffff
      background-color: #7a1f1f

  UIWidget
    id: nav
    anchors.top: headerBar.bottom
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 140
    margin-top: 16
    margin-left: 16
    margin-bottom: 16
    layout:
      type: verticalBox
      spacing: 4

    AdmTab
      id: navPlayers
      text: Jogadores

    AdmTab
      id: navItems
      text: Itens

    AdmTab
      id: navMons
      text: Pokemon / Monstros

    AdmTab
      id: navEdit
      text: Editar Pokemon

    AdmTab
      id: navCastle
      text: Castelos

    AdmTab
      id: navTele
      text: Teleporte

    AdmTab
      id: navServer
      text: Servidor

    AdmTab
      id: navMe
      text: Eu (GM)

    AdmTab
      id: navStaff
      text: Equipe
      visible: false

  UIWidget
    id: content
    anchors.top: nav.top
    anchors.left: nav.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 12
    margin-right: 16
    margin-bottom: 16

    UIWidget
      id: tabPlayers
      anchors.fill: parent

      AdmEdit
        id: playerFilter
        anchors.top: parent.top
        anchors.left: parent.left
        width: 200
        !tooltip: tr('Nome, ID do personagem ou ID da conta. Enter ou Buscar procura tambem quem esta offline.')

      AdmButton
        id: playerSearch
        text: Buscar
        anchors.top: parent.top
        anchors.left: playerFilter.right
        margin-left: 6
        width: 70

      AdmButton
        id: playerRefresh
        text: Online
        anchors.top: parent.top
        anchors.left: playerSearch.right
        margin-left: 6
        width: 70

      AdmLabel
        id: playerCount
        anchors.verticalCenter: playerRefresh.verticalCenter
        anchors.left: playerRefresh.right
        margin-left: 10

      ScrollablePanel
        id: playerList
        anchors.top: playerFilter.bottom
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        width: 380
        margin-top: 8
        vertical-scrollbar: playerScroll
        layout:
          type: verticalBox
          spacing: 3

      VerticalScrollBar
        id: playerScroll
        anchors.top: playerList.top
        anchors.bottom: playerList.bottom
        anchors.left: playerList.right
        width: 10
        step: 30
        pixels-scroll: true

      AdmBox
        id: playerActions
        anchors.top: parent.top
        anchors.left: playerScroll.right
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-left: 10

        AdmTitle
          id: pTitle
          text: JOGADOR
          anchors.top: parent.top
          anchors.left: parent.left
          margin: 10 0 0 12

        AdmEdit
          id: playerName
          anchors.top: pTitle.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin: 6 12 0 12

        AdmButton
          id: pGoto
          text: Ir ate
          anchors.top: playerName.bottom
          anchors.left: parent.left
          margin: 8 0 0 12
          width: 96

        AdmButton
          id: pBring
          text: Puxar
          anchors.top: pGoto.top
          anchors.left: pGoto.right
          margin-left: 6
          width: 96

        AdmButton
          id: pHeal
          text: Curar
          anchors.top: pGoto.top
          anchors.left: pBring.right
          margin-left: 6
          width: 96

        AdmButton
          id: pTemple
          text: Templo
          anchors.top: pGoto.bottom
          anchors.left: pGoto.left
          margin-top: 6
          width: 96

        AdmRed
          id: pKick
          text: Expulsar
          anchors.top: pTemple.top
          anchors.left: pTemple.right
          margin-left: 6
          width: 96
          height: 22

        AdmTitle
          id: banTitle
          text: BANIMENTO
          anchors.top: pTemple.bottom
          anchors.left: parent.left
          margin: 16 0 0 12

        AdmLabel
          id: banDaysLabel
          text: Dias
          anchors.top: banTitle.bottom
          anchors.left: parent.left
          margin: 8 0 0 12

        AdmEdit
          id: banDays
          text: 7
          anchors.verticalCenter: banDaysLabel.verticalCenter
          anchors.left: banDaysLabel.right
          margin-left: 8
          width: 50

        AdmEdit
          id: banReason
          anchors.verticalCenter: banDaysLabel.verticalCenter
          anchors.left: banDays.right
          anchors.right: parent.right
          margin-left: 8
          margin-right: 12

        AdmRed
          id: pBan
          text: Banir
          anchors.top: banReason.bottom
          anchors.left: parent.left
          margin: 8 0 0 12
          width: 96
          height: 22

        AdmButton
          id: pUnban
          text: Desbanir
          anchors.top: pBan.top
          anchors.left: pBan.right
          margin-left: 6
          width: 96

        AdmTitle
          id: coinTitle
          text: DAR MOEDAS
          anchors.top: pBan.bottom
          anchors.left: parent.left
          margin: 16 0 0 12

        AdmButton
          id: curGOLD
          text: Gold
          anchors.top: coinTitle.bottom
          anchors.left: parent.left
          margin: 8 0 0 12
          width: 72

        AdmButton
          id: curPOKECOINS
          text: PokeCoins
          anchors.top: curGOLD.top
          anchors.left: curGOLD.right
          margin-left: 4
          width: 72

        AdmButton
          id: curDONATE
          text: Donate
          anchors.top: curGOLD.top
          anchors.left: curPOKECOINS.right
          margin-left: 4
          width: 72

        AdmButton
          id: curTOKENS
          text: Tokens
          anchors.top: curGOLD.top
          anchors.left: curDONATE.right
          margin-left: 4
          width: 72

        AdmEdit
          id: coinAmount
          anchors.top: curGOLD.bottom
          anchors.left: parent.left
          margin: 6 0 0 12
          width: 120

        AdmGold
          id: pCoins
          text: Dar
          anchors.verticalCenter: coinAmount.verticalCenter
          anchors.left: coinAmount.right
          margin-left: 6
          width: 70
          height: 22

        AdmTitle
          id: premTitle
          text: PREMIUM (DIAS)
          anchors.top: coinAmount.bottom
          anchors.left: parent.left
          margin: 16 0 0 12

        AdmEdit
          id: premDays
          anchors.top: premTitle.bottom
          anchors.left: parent.left
          margin: 6 0 0 12
          width: 120

        AdmGold
          id: pPremium
          text: Dar
          anchors.verticalCenter: premDays.verticalCenter
          anchors.left: premDays.right
          margin-left: 6
          width: 70
          height: 22

    UIWidget
      id: tabItems
      anchors.fill: parent
      visible: false

      AdmEdit
        id: itemSearch
        anchors.top: parent.top
        anchors.left: parent.left
        width: 300

      AdmButton
        id: itemSearchButton
        text: Buscar
        anchors.top: parent.top
        anchors.left: itemSearch.right
        margin-left: 6
        width: 80

      AdmLabel
        id: itemHint
        text: nome ou ID do item
        anchors.verticalCenter: itemSearchButton.verticalCenter
        anchors.left: itemSearchButton.right
        margin-left: 10

      ScrollablePanel
        id: itemGrid
        anchors.top: itemSearch.bottom
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        width: 400
        margin-top: 8
        vertical-scrollbar: itemScroll
        layout:
          type: verticalBox
          spacing: 3

      VerticalScrollBar
        id: itemScroll
        anchors.top: itemGrid.top
        anchors.bottom: itemGrid.bottom
        anchors.left: itemGrid.right
        width: 10
        step: 44
        pixels-scroll: true

      AdmBox
        id: itemBox
        anchors.top: parent.top
        anchors.left: itemScroll.right
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-left: 10

        UIItem
          id: itemPreview
          size: 64 64
          anchors.top: parent.top
          anchors.left: parent.left
          margin: 12 0 0 12
          virtual: true
          background-color: #07101c
          border-width: 1
          border-color: #24415f

        Label
          id: itemName
          anchors.top: itemPreview.top
          anchors.left: itemPreview.right
          anchors.right: parent.right
          margin-left: 10
          margin-right: 10
          font: verdana-11px-antialised
          color: #ffffff
          text-wrap: true
          height: 32

        AdmLabel
          id: itemIdLabel
          anchors.top: itemName.bottom
          anchors.left: itemName.left

        AdmLabel
          id: itemCountLabel
          text: Quantidade
          anchors.top: itemPreview.bottom
          anchors.left: parent.left
          margin: 14 0 0 12

        AdmEdit
          id: itemCount
          text: 1
          anchors.top: itemCountLabel.bottom
          anchors.left: parent.left
          margin: 4 0 0 12
          width: 90

        AdmLabel
          id: itemTargetLabel
          text: Para (vazio = voce)
          anchors.top: itemCount.bottom
          anchors.left: parent.left
          margin: 10 0 0 12

        AdmEdit
          id: itemTarget
          anchors.top: itemTargetLabel.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin: 4 12 0 12

        AdmButton
          id: itemToBag
          text: Mochila
          anchors.top: itemTarget.bottom
          anchors.left: parent.left
          margin: 10 0 0 12
          width: 90

        AdmButton
          id: itemToDepot
          text: PC
          anchors.top: itemToBag.top
          anchors.left: itemToBag.right
          margin-left: 6
          width: 90

        AdmGreen
          id: itemCreate
          text: Criar item
          anchors.top: itemToBag.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin: 14 12 0 12

    UIWidget
      id: tabMons
      anchors.fill: parent
      visible: false

      AdmEdit
        id: monSearch
        anchors.top: parent.top
        anchors.left: parent.left
        width: 196

      AdmButton
        id: monSearchButton
        text: Buscar
        anchors.top: parent.top
        anchors.left: monSearch.right
        margin-left: 6
        width: 78

      ScrollablePanel
        id: monList
        anchors.top: monSearch.bottom
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        width: 280
        margin-top: 8
        vertical-scrollbar: monScroll
        layout:
          type: verticalBox
          spacing: 3

      VerticalScrollBar
        id: monScroll
        anchors.top: monList.top
        anchors.bottom: monList.bottom
        anchors.left: monList.right
        width: 10
        step: 47
        pixels-scroll: true

      AdmBox
        id: monBox
        anchors.top: parent.top
        anchors.left: monScroll.right
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-left: 10

        UICreature
          id: monPreview
          size: 56 56
          anchors.top: parent.top
          anchors.left: parent.left
          margin: 10 0 0 12
          background-color: #07101c
          border-width: 1
          border-color: #24415f

        Label
          id: monName
          anchors.top: monPreview.top
          anchors.left: monPreview.right
          anchors.right: parent.right
          margin-top: 4
          margin-left: 10
          font: verdana-11px-antialised
          color: #ffffff

        AdmButton
          id: monShiny
          text: Shiny
          anchors.bottom: monPreview.bottom
          anchors.left: monPreview.right
          margin-left: 10
          width: 60

        AdmLabel
          id: monLevelLabel
          text: Level
          anchors.verticalCenter: monShiny.verticalCenter
          anchors.left: monShiny.right
          margin-left: 12

        AdmEdit
          id: monLevel
          text: 1
          anchors.verticalCenter: monShiny.verticalCenter
          anchors.left: monLevelLabel.right
          margin-left: 6
          width: 56

        AdmLabel
          id: monBoostLabel
          text: Boost
          anchors.verticalCenter: monShiny.verticalCenter
          anchors.left: monLevel.right
          margin-left: 10

        AdmEdit
          id: monBoost
          text: 0
          anchors.verticalCenter: monShiny.verticalCenter
          anchors.left: monBoostLabel.right
          margin-left: 6
          width: 48

        UIWidget
          id: attrBar
          size: 3 14
          anchors.top: monPreview.bottom
          anchors.left: parent.left
          margin-top: 14
          margin-left: 12
          background-color: #f2c400
          phantom: true

        AdmTitle
          id: attrTitle
          text: ATRIBUTOS (vale para os dois)
          anchors.verticalCenter: attrBar.verticalCenter
          anchors.left: attrBar.right
          margin-left: 6

        AdmButton
          id: attrClear
          text: Limpar
          anchors.verticalCenter: attrBar.verticalCenter
          anchors.right: parent.right
          margin-right: 12
