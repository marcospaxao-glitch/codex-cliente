CSTitle < Label
  font: verdana-11px-rounded
  color: #a970ff
  text-auto-resize: true
  margin-top: 12

CSLine < Label
  font: verdana-11px-antialised
  color: #c9d6ea
  text-auto-resize: true

CSEmote < Button
  width: 54
  height: 24
  margin-right: 4

MainWindow
  id: codexStreamerWindow
  text: Painel do Streamer
  size: 440 590
  @onEscape: modules.game_codexstreamer.hide()

  Label
    id: liveState
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 24
    font: sans-bold-16px
    text-align: center

  Label
    id: stats
    anchors.top: liveState.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    font: verdana-11px-antialised
    color: #8ea4c2
    text-align: center
    text-wrap: true
    height: 30

  CSTitle
    id: tLink
    anchors.top: stats.bottom
    anchors.left: parent.left
    text: LINK DA LIVE (Twitch, YouTube, Kick, TikTok...)

  TextEdit
    id: link
    anchors.top: tLink.bottom
    anchors.left: parent.left
    anchors.right: saveLink.left
    margin-top: 4
    margin-right: 6
    height: 22
    max-length: 200

  Button
    id: saveLink
    anchors.top: tLink.bottom
    margin-top: 4
    anchors.right: parent.right
    width: 70
    height: 22
    text: Salvar
    @onClick: modules.game_codexstreamer.sendLink()

  Button
    id: liveButton
    anchors.top: link.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    height: 30
    @onClick: modules.game_codexstreamer.toggleLive()

  CSTitle
    id: tDraw
    anchors.top: liveButton.bottom
    anchors.left: parent.left

  TextEdit
    id: drawName
    anchors.top: tDraw.bottom
    anchors.left: parent.left
    anchors.right: drawButton.left
    margin-top: 4
    margin-right: 6
    height: 22
    max-length: 30
    placeholder: Nome do jogador

  Button
    id: drawButton
    anchors.top: tDraw.bottom
    anchors.right: parent.right
    margin-top: 4
    width: 70
    height: 22
    text: Sortear
    @onClick: modules.game_codexstreamer.doDraw()

  ComboBox
    id: prize
    anchors.top: drawName.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 22

  CSTitle
    id: tLure
    anchors.top: prize.bottom
    anchors.left: parent.left
    text: CHAMARIZ DE LIVE

  Button
    id: lureButton
    anchors.top: tLure.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 24
    @onClick: modules.game_codexstreamer.send('LURE')

  CSTitle
    id: tTravel
    anchors.top: lureButton.bottom
    anchors.left: parent.left
    text: VIAGEM GRATIS E TV (ao vivo)

  ComboBox
    id: town
    anchors.top: tTravel.bottom
    anchors.left: parent.left
    anchors.right: travelButton.left
    margin-top: 4
    margin-right: 6
    height: 22

  Button
    id: travelButton
    anchors.top: tTravel.bottom
    margin-top: 4
    anchors.right: tvButton.left
    margin-right: 6
    width: 70
    height: 22
    text: Viajar
    @onClick: modules.game_codexstreamer.doTravel()

  Button
    id: tvButton
    anchors.top: tTravel.bottom
    margin-top: 4
    anchors.right: parent.right
    width: 90
    height: 22
    text: Assistir TV
    @onClick: modules.game_codexstreamer.send('TV')

  CSTitle
    id: tEmote
    anchors.top: town.bottom
    anchors.left: parent.left
    text: EMOTES (efeito em cima de voce e do seu pokemon)

  Panel
    id: emotes
    anchors.top: tEmote.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 26
    layout:
      type: horizontalBox
      spacing: 4

  CSLine
    id: tips
    anchors.top: emotes.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 12
    text-wrap: true
    text-auto-resize: false
    height: 60
    color: #8ea4c2

  Button
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 80
    text: Fechar
    @onClick: modules.game_codexstreamer.hide()
