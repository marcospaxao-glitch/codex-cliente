UIWindow
  id: pokemonManager
  size: 818 730
  focusable: false
  background-color: #101F3E
  opacity: 0.99

  Panel
    id: mainWindow
    anchors.fill: parent
    focusable: false
    background-color: #101F3E

    Panel
      id: header
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 52
      focusable: false
      background-color: #0a1428
      image-source: /modules/game_pokemonmanager/v2/pm2_header

      UIWidget
        id: codexHeaderLogo
