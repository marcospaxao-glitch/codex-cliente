PMAbilityPassiveRow < Panel
  height: 62
  background-color: #0c1828
  border-width: 1
  border-color: #1c3350
  focusable: false

  Panel
    id: passiveAccent
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 3
    background-color: #3a5170
    focusable: false

  Panel
    id: passiveTagBox
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 70
    height: 22
    margin-left: 14
    background-color: #101F3E
    border-width: 1
    border-color: #f2c400
    focusable: false

    Label
      id: passiveTag
      anchors.fill: parent
      text: "PASSIVA"
      text-align: center
      font: verdana-11px-antialised
      color: #f2c400
      phantom: true

  Label
    id: passiveName
    anchors.left: passiveTagBox.right
    anchors.right: passiveStatus.left
    anchors.top: parent.top
    height: 18
    margin-top: 7
    margin-left: 12
    margin-right: 8
    text-align: left
    font: verdana-11px-antialised
    color: #ffffff

  Label
    id: passiveDesc
    anchors.left: passiveName.left
    anchors.right: passiveStatus.left
    anchors.top: passiveName.bottom
    anchors.bottom: parent.bottom
    margin-right: 8
    margin-bottom: 5
    text-align: topLeft
    text-wrap: true
    font: verdana-11px-rounded
    color: #8fa7c4
    phantom: true

  Label
    id: passiveStatus
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    width: 90
    height: 20
    margin-right: 14
    text-align: right
    font: verdana-11px-antialised
    color: #7f94b1

