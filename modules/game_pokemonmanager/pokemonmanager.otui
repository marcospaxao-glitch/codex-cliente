    font: verdana-11px-rounded
    color: #9bb6dc

  Panel
    id: levelTrack
    anchors.left: levelText.right
    anchors.verticalCenter: levelText.verticalCenter
    anchors.right: levelButton.left
    height: 5
    margin-left: 6
    margin-right: 10
    background-color: #091522
    focusable: false

    UIWidget
      id: levelFill
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      width: 0
      background-color: #3a6ea5
      phantom: true

  PMSkinButton
    id: levelButton
    anchors.right: parent.right
    anchors.verticalCenter: levelText.verticalCenter
    width: 104
    height: 22
    margin-right: 10
    text: "EVOLUIR"
    color: #8ff09a

    $disabled:
      color: #5f7596

  UIItem
    id: stoneItem
    anchors.left: name.left
    anchors.top: levelText.bottom
    size: 32 32
    margin-top: 6
    virtual: true
    phantom: true

  Label
    id: stoneText
    anchors.left: stoneItem.right
    anchors.verticalCenter: stoneItem.verticalCenter
    anchors.right: stoneButton.left
    height: 14
    margin-left: 6
    margin-right: 8
    font: verdana-11px-rounded
    color: #dce8f5

  PMSkinButton
    id: stoneButton
    anchors.right: parent.right
    anchors.verticalCenter: stoneItem.verticalCenter
    width: 104
    height: 22
    margin-right: 10
    text: "USAR PEDRAS"
    color: #f2c400

    $disabled:
      color: #5f7596

