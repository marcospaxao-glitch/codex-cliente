PMTab < UIButton
  height: 38
  focusable: false
  font: ChakraPetch-Bold_13
  color: #d6e4f7
  background-color: #00000000
  border-width: 0
  image-source: /modules/game_pokemonmanager/v2/pm2_tab
  image-border: 12
  text-align: center
  text-offset: 10 0

  $hover:
    image-source: /modules/game_pokemonmanager/v2/pm2_tab_hover
    color: #ffffff

  $on:
    image-source: /modules/game_pokemonmanager/v2/pm2_tab_on
    color: #1b1400

  UIWidget
    id: icon
    size: 18 18
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    margin-left: 6
    image-size: 18 18
    phantom: true

PMSubTab < UIButton
  height: 26
  focusable: false
  font: ChakraPetch-SemiBold_12
  color: #9fb3cf
  background-color: #0f1b2e
  border-width: 1
  border-color: #2b4a75
  text-align: center
  text-auto-resize: true
  padding: 0 14 0 14

  $hover:
    color: #ffffff
    border-color: #4f9cf0

  $on:
    color: #ffffff
    background-color: #1d3a66
    border-color: #4f9cf0
    font: verdana-11px-antialised

