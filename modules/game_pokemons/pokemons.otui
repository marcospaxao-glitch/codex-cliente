PTSlotCard < UIWidget
  size: 176 96
  background-color: #0c1828
  border-width: 1
  border-color: #1d3557
  focusable: false

  $hover:
    background-color: #101f3e

  UIWidget
    id: goldBar
    size: 3 14
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 6
    margin-left: 6
    background-color: #f2c400
    phantom: true

  Label
    id: slotLabel
    anchors.verticalCenter: goldBar.verticalCenter
    anchors.left: goldBar.right
    margin-left: 5
    font: verdana-11px-rounded
    color: #f2c400
    text-auto-resize: true
    phantom: true

  Label
    id: statusLabel
    anchors.verticalCenter: goldBar.verticalCenter
    anchors.right: parent.right
    margin-right: 6
    font: verdana-11px-rounded
    color: #5fd35f
    text-auto-resize: true
    phantom: true

  UIWidget
    id: portrait
    size: 48 48
    anchors.left: parent.left
    anchors.top: goldBar.bottom
    margin-left: 6
    margin-top: 6
    image-size: 44 44
    background-color: #07101c
    border-width: 1
    border-color: #1d3557
    phantom: true

  UICreature
    id: creature
    size: 46 46
    anchors.centerIn: portrait
    visible: false
    phantom: true

  UIItem
    id: ballSlot
    size: 34 34
    anchors.left: portrait.right
    anchors.verticalCenter: portrait.verticalCenter
    margin-left: 4
    virtual: true
    background-color: #07101c
    border-width: 1
    border-color: #f2c400

    $hover:
      background-color: #16284a

  Label
    id: nameLabel
    anchors.top: portrait.top
    anchors.left: ballSlot.right
    anchors.right: parent.right
    margin-left: 6
    margin-right: 4
    font: verdana-11px-rounded
    color: #ffffff
    text-auto-resize: false
    height: 14
    phantom: true

  Label
    id: levelLabel
    anchors.top: nameLabel.bottom
    anchors.left: nameLabel.left
    anchors.right: nameLabel.right
    margin-top: 2
    font: verdana-11px-rounded
    color: #9fb3c8
    height: 14
    phantom: true

  ProgressBar
    id: hpBar
    anchors.top: levelLabel.bottom
    anchors.left: nameLabel.left
    anchors.right: nameLabel.right
    margin-top: 4
    height: 10
    background-color: #5fd35f
    phantom: true

  UIWidget
    id: genderIcon
    size: 11 11
    anchors.top: portrait.bottom
    anchors.left: portrait.left
    margin-top: 5
    phantom: true

  UIWidget
    id: starsBox
    size: 59 11
    anchors.top: genderIcon.top
    anchors.left: genderIcon.right
    margin-left: 5
    phantom: true
    layout:
      type: horizontalBox
      spacing: 1

  Label
    id: tagsLabel
    anchors.verticalCenter: genderIcon.verticalCenter
    anchors.left: starsBox.right
    anchors.right: parent.right
    margin-left: 6
    margin-right: 4
    height: 13
    font: verdana-11px-rounded
    color: #ffd84a
    phantom: true

  Label
    id: emptyLabel
    anchors.centerIn: parent
    margin-top: 10
    font: verdana-11px-rounded
    color: #4a5f7a
    text-auto-resize: true
    phantom: true

PTSlotRow < UIWidget
  size: 184 54
  background-color: #0c1828
  border-width: 1
  border-color: #1d3557
  focusable: false

  $hover:
    background-color: #101f3e

  UIWidget
    id: portrait
    size: 44 44
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    image-size: 40 40
    background-color: #07101c
    border-width: 1
    border-color: #1d3557
    phantom: true

  UICreature
    id: creature
    size: 42 42
    anchors.centerIn: portrait
    visible: false
    phantom: true

  Label
    id: slotLabel
    anchors.top: portrait.top
    anchors.left: portrait.left
    margin-top: 1
    margin-left: 3
    font: verdana-11px-rounded
    color: #f2c400
    text-auto-resize: true
    phantom: true

  UIItem
    id: ballSlot
    size: 26 26
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 4
    margin-right: 4
    virtual: true
    background-color: #07101c
    border-width: 1
    border-color: #f2c400

    $hover:
      background-color: #16284a

  Label
    id: nameLabel
    anchors.top: parent.top
    anchors.left: portrait.right
    anchors.right: ballSlot.left
    margin-top: 5
    margin-left: 5
    margin-right: 3
    font: verdana-11px-rounded
    color: #ffffff
    text-auto-resize: false
    height: 14
    phantom: true

  Label
    id: levelLabel
    anchors.top: nameLabel.bottom
    anchors.left: nameLabel.left
    anchors.right: nameLabel.right
    margin-top: 1
    font: verdana-11px-rounded
    color: #9fb3c8
    height: 13
    phantom: true

  Label
    id: statusLabel
    anchors.verticalCenter: levelLabel.verticalCenter
    anchors.right: parent.right
    margin-right: 5
    font: verdana-11px-rounded
    color: #5fd35f
    text-auto-resize: true
    phantom: true

  ProgressBar
    id: hpBar
    anchors.bottom: parent.bottom
    anchors.left: nameLabel.left
    anchors.right: parent.right
    margin-bottom: 6
    margin-right: 5
    height: 7
    background-color: #5fd35f
    phantom: true

  Label
    id: emptyLabel
    anchors.centerIn: parent
    font: verdana-11px-rounded
    color: #4a5f7a
    text-auto-resize: true
    phantom: true

PTSlotMini < UIWidget
  size: 68 76
  background-color: #0c1828
  border-width: 1
  border-color: #1d3557
  focusable: false

  $hover:
    background-color: #101f3e

  Label
    id: slotLabel
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 1
    margin-left: 3
    font: verdana-11px-rounded
    color: #f2c400
    text-auto-resize: true
    phantom: true

  UIItem
    id: ballSlot
    size: 18 18
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 2
    margin-right: 2
    virtual: true
    background-color: #07101c
    border-width: 1
    border-color: #f2c400

    $hover:
      background-color: #16284a

  UIWidget
    id: portrait
    size: 40 40
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 5
    image-size: 36 36
    phantom: true

  UICreature
    id: creature
    size: 42 42
    anchors.centerIn: portrait
    visible: false
    phantom: true

  Label
    id: statusLabel
    anchors.bottom: portrait.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    font: verdana-11px-rounded
    color: #5fd35f
    text-auto-resize: true
    phantom: true

  Label
    id: nameLabel
    anchors.top: portrait.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    margin-left: 2
    margin-right: 2
    height: 13
    font: verdana-11px-rounded
    color: #ffffff
    text-align: center
    text-auto-resize: false
    phantom: true

  Label
    id: levelLabel
    anchors.top: nameLabel.bottom
    anchors.left: parent.left
    width: 1
    height: 1
    visible: false
    phantom: true

  ProgressBar
    id: hpBar
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 0 5 5 5
    height: 5
    background-color: #5fd35f
    phantom: true

  Label
    id: emptyLabel
    anchors.centerIn: parent
    font: verdana-11px-rounded
    color: #4a5f7a
    text-auto-resize: true
    phantom: true

PTButton < Button
  height: 24
  width: 118

UIWindow
  id: pokemonsWindow
  size: 568 356
  anchors.centerIn: parent
  background-color: #0a1320
  border-width: 1
  border-color: #f2c400
  focusable: true
  visible: false

  UIWidget
    id: headerBar
    size: 4 18
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 12
    margin-left: 12
    background-color: #f2c400
    phantom: true

  Label
    id: titleLabel
    text: POKEMONS
    anchors.verticalCenter: headerBar.verticalCenter
    anchors.left: headerBar.right
    margin-left: 8
    font: verdana-11px-rounded
    color: #f2c400
    text-auto-resize: true
    phantom: true

  Label
    id: countLabel
    anchors.verticalCenter: headerBar.verticalCenter
    anchors.left: titleLabel.right
    margin-left: 10
    font: verdana-11px-rounded
    color: #9fb3c8
    text-auto-resize: true
    phantom: true

  Button
    id: modeButton
    size: 22 20
    anchors.top: parent.top
    anchors.right: closeButton.left
    margin-top: 10
    margin-right: 4
    @onClick: modules.game_pokemons.toggleCompact()

  Button
    id: closeButton
    text: X
    size: 22 20
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 10
    margin-right: 10
    @onClick: modules.game_pokemons.hide()

  Panel
    id: slotsPanel
    anchors.top: headerBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 12
    margin-left: 12
    margin-right: 12
    height: 202
    layout:
      type: grid
      cell-size: 176 96
      cell-spacing: 8
      num-columns: 3
      flow: true

  Label
    id: hintLabel
    anchors.top: slotsPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    margin-left: 12
    margin-right: 12
    height: 28
    font: verdana-11px-rounded
    color: #9fb3c8
    text-wrap: true
    text-align: center

  PTButton
    id: useButton
    text: Usar / Recolher
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 12
    margin-left: 12
    @onClick: modules.game_pokemons.useSelected()

  PTButton
    id: cpButton
    text: Enviar ao CP
    anchors.bottom: parent.bottom
    anchors.left: useButton.right
    margin-bottom: 12
    margin-left: 8
    @onClick: modules.game_pokemons.sendSelectedToCp()

  PTButton
    id: cancelButton
    text: Cancelar selecao
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 12
    margin-right: 12
    @onClick: modules.game_pokemons.clearSelection()
