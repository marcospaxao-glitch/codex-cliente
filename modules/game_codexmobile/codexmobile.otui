// HUD do celular (so aparece quando codexCelular() e verdadeiro)
CodexImgBotao < UIButton
  focusable: false
  text:
  image-color: #ffffffff

CodexTopoIcone < CodexImgBotao
  size: 44 44
  anchors.verticalCenter: parent.verticalCenter
  anchors.left: prev.right
  margin-left: 4

CodexPilula < CodexImgBotao
  size: 124 44
  anchors.verticalCenter: parent.verticalCenter
  anchors.right: prev.left
  margin-right: 8

CodexAba < CodexImgBotao
  size: 196 48
  image-source: /game_codexmobile/images/aba
  icon-size: 26 26
  icon-offset: 14 0
  icon-align: left
  text-align: left
  text-offset: 50 0
  font: verdana-11px-rounded
  color: #ffffff
  margin-bottom: 6
  $on:
    image-source: /game_codexmobile/images/aba_on
    color: #f5c518

CodexTile < CodexImgBotao
  size: 108 96
  image-source: /game_codexmobile/images/tile
  icon-size: 36 36
  icon-offset: 0 -12
  text-offset: 0 26
  font: verdana-11px-rounded
  color: #ffffff
  $pressed:
    image-source: /game_codexmobile/images/tile_on

CodexMapaBotao < CodexImgBotao
  size: 40 40
  anchors.right: parent.right
  margin-right: 4

UIWidget
  anchors.fill: parent
  focusable: false
  phantom: true

  // ===== joystick (embaixo, esquerda) =====
  UIWidget
    id: keypad
    size: 176 176
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-left: 14
    margin-bottom: 12
    phantom: false
    focusable: false
    visible: false
    image-source: /game_codexmobile/images/joy_base

    UIWidget
      id: pointer
      size: 62 62
      anchors.verticalCenter: parent.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter
      image-source: /game_codexmobile/images/joy_bola
      phantom: true
      focusable: false

  CodexImgBotao
    id: montaria
    size: 68 68
    anchors.bottom: parent.bottom
    anchors.left: keypad.right
    margin-left: -6
    margin-bottom: 4
    image-source: /game_codexmobile/images/montaria
    visible: false
    $pressed:
      image-source: /game_codexmobile/images/montaria_on

  // ===== trocar alvo + ATACAR (arrastaveis pela alca) =====
  UIWidget
    id: acoes
    size: 150 232
    anchors.top: parent.top
    anchors.left: parent.left
    phantom: true
    focusable: false
    visible: false

    UIWidget
      id: mover
      size: 30 30
      image-source: /game_codexmobile/images/mover
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 22
      margin-left: 4
      draggable: true
      focusable: false
      opacity: 0.7

    CodexImgBotao
      id: trocar
      size: 68 68
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 0
      margin-left: 56
      image-source: /game_codexmobile/images/trocar
      $pressed:
        image-source: /game_codexmobile/images/trocar_on

    CodexImgBotao
      id: atacar
      size: 136 136
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 92
      margin-left: 10
      image-source: /game_codexmobile/images/atacar
      $pressed:
        image-source: /game_codexmobile/images/atacar_on

  // ===== barra do topo =====
  UIWidget
    id: topo
    height: 56
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    image-source: /game_codexmobile/images/topo_fundo
    phantom: false
    focusable: false
    visible: false

    CodexImgBotao
      id: btnSair
      size: 44 44
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      margin-left: 12
      image-source: /game_codexmobile/images/ic_sair
      $pressed:
        image-source: /game_codexmobile/images/ic_sair_on

    CodexTopoIcone
      id: btnOpcoes
      image-source: /game_codexmobile/images/ic_opcoes
      $pressed:
        image-source: /game_codexmobile/images/ic_opcoes_on

    CodexTopoIcone
      id: btnSom
      image-source: /game_codexmobile/images/ic_som

    CodexTopoIcone
      id: btnTrava
      image-source: /game_codexmobile/images/ic_destrava

    UIWidget
      id: logo
      size: 136 66
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      margin-top: -1
      image-source: /game_codexmobile/images/logo
      image-fixed-ratio: true
      phantom: true

    CodexImgBotao
      id: btnMenu
      size: 124 44
      anchors.verticalCenter: parent.verticalCenter
      anchors.right: parent.right
      margin-right: 10
      image-source: /game_codexmobile/images/pil_menu
      $pressed:
        image-source: /game_codexmobile/images/pil_menu_on

    CodexPilula
      id: btnPokemon
      image-source: /game_codexmobile/images/pil_poke
      $pressed:
        image-source: /game_codexmobile/images/pil_poke_on

    CodexPilula
      id: btnMochila
      image-source: /game_codexmobile/images/pil_bolsa
      $pressed:
        image-source: /game_codexmobile/images/pil_bolsa_on

    CodexPilula
      id: btnFechar
      visible: false
      image-source: /game_codexmobile/images/pil_fechar
      $pressed:
        image-source: /game_codexmobile/images/pil_fechar_on

  // ===== cartao do jogador =====
  UIWidget
    id: cartao
    size: 300 86
    anchors.top: topo.bottom
    anchors.left: parent.left
    margin-top: 4
    margin-left: 6
    image-source: /game_codexmobile/images/cartao
    phantom: true
    focusable: false
    visible: false

    UICreature
      id: retrato
      size: 64 64
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 10
      margin-left: 10
      phantom: true
      focusable: false

    Label
      id: nome
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 13
      margin-left: 96
      font: verdana-11px-rounded
      color: #ffffff
      text-auto-resize: true
      phantom: true

    Label
      id: nivel
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 13
      margin-right: 14
      font: verdana-11px-rounded
      color: #f5c518
      text-auto-resize: true
      phantom: true

    UIWidget
      id: vidaFundo
      height: 18
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 33
      margin-left: 94
      margin-right: 12
      image-source: /game_codexmobile/images/barra_fundo
      image-border: 8
      phantom: true

      UIWidget
        id: vida
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        width: 10
        image-source: /game_codexmobile/images/barra_vida
        image-border: 8
        phantom: true

      Label
        id: vidaTexto
        anchors.centerIn: parent
        font: verdana-11px-rounded
        color: #ffffff
        text-auto-resize: true
        phantom: true

    UIWidget
      id: xpFundo
      height: 18
      anchors.top: vidaFundo.bottom
      anchors.left: vidaFundo.left
      anchors.right: vidaFundo.right
      margin-top: 4
      image-source: /game_codexmobile/images/barra_fundo
      image-border: 8
      phantom: true

      UIWidget
        id: xp
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        width: 10
        image-source: /game_codexmobile/images/barra_xp
        image-border: 8
        phantom: true

      Label
        id: xpTexto
        anchors.centerIn: parent
        font: verdana-11px-rounded
        color: #ffffff
        text-auto-resize: true
        phantom: true

  // ===== minimapa =====
  UIWidget
    id: miniMapa
    size: 230 210
    anchors.top: topo.bottom
    anchors.right: parent.right
    margin-top: 4
    margin-right: 6
    image-source: /game_codexmobile/images/mapa_moldura
    image-border: 14
    focusable: false
    visible: false

    UIWidget
      id: pino
      size: 20 20
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 10
      margin-left: 12
      image-source: /game_codexmobile/images/pino_dourado
      phantom: true

    Label
      id: titulo
      text: Minimapa
      anchors.verticalCenter: pino.verticalCenter
      anchors.left: pino.right
      margin-left: 6
      font: verdana-11px-rounded
      color: #ffffff
      text-auto-resize: true
      phantom: true

    CodexImgBotao
      id: expandir
      size: 32 30
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 6
      margin-right: 8
      image-source: /game_codexmobile/images/mapa_expandir
      $pressed:
        image-source: /game_codexmobile/images/mapa_expandir_on

    Minimap
      id: mapa
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: coords.top
      margin-top: 40
      margin-left: 10
      margin-right: 50
      margin-bottom: 2

    CodexMapaBotao
      id: zoomMais
      anchors.top: parent.top
      margin-top: 40
      image-source: /game_codexmobile/images/mapa_mais
      $pressed:
        image-source: /game_codexmobile/images/mapa_mais_on

    CodexMapaBotao
      id: zoomMenos
      anchors.top: prev.bottom
      margin-top: 2
      image-source: /game_codexmobile/images/mapa_menos
      $pressed:
        image-source: /game_codexmobile/images/mapa_menos_on

    CodexMapaBotao
      id: centralizar
      anchors.top: prev.bottom
      margin-top: 2
      image-source: /game_codexmobile/images/mapa_centro
      $pressed:
        image-source: /game_codexmobile/images/mapa_centro_on

    Label
      id: coords
      height: 22
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-bottom: 6
      text-align: center
      font: verdana-11px-rounded
      color: #ffffff
      phantom: true

  // ===== LOOT (embaixo do minimapa) =====
  CodexImgBotao
    id: loot
    size: 78 78
    anchors.top: miniMapa.bottom
    anchors.right: parent.right
    margin-top: 10
    margin-right: 22
    image-source: /game_codexmobile/images/loot
    visible: false
    $pressed:
      image-source: /game_codexmobile/images/loot_on

  // ===== menu do celular (grupos a esquerda, sistemas a direita) =====
  UIWidget
    id: menuCelular
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 62
    margin-left: 30
    margin-right: 30
    margin-bottom: 8
    image-source: /game_codexmobile/images/menu_fundo
    image-border: 18
    phantom: false
    focusable: false
    visible: false

    Label
      id: titulo
      text: MENU
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 16
      margin-left: 22
      font: sans-bold-16px
      color: #f5c518
      text-auto-resize: true
      phantom: true

    CodexImgBotao
      id: fechar
      size: 54 54
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 6
      margin-right: 8
      image-source: /game_codexmobile/images/fechar
      $pressed:
        image-source: /game_codexmobile/images/fechar_on

    UIWidget
      id: grupos
      width: 196
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      margin-top: 52
      margin-left: 16
      margin-bottom: 14
      phantom: true
      layout:
        type: verticalBox
        spacing: 6

    UIWidget
      id: itens
      anchors.top: parent.top
      anchors.left: grupos.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 64
      margin-left: 18
      margin-right: 14
      margin-bottom: 14
      phantom: true
      layout:
        type: grid
        cell-size: 108 96
        cell-spacing: 10
        flow: true
