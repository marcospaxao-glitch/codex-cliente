PCPokeSlot < UIWidget
  size: 128 100
  background-color: #07101c
  border-width: 1
  border-color: #16294a
  draggable: true

  $hover:
    border-color: #2b4a75

  Label
    id: slotLabel
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 2
    margin-left: 4
    font: verdana-11px-rounded
    color: #24415f
    text-auto-resize: true
    phantom: true

  UIWidget
    id: portrait
    size: 56 56
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    image-size: 56 56
    phantom: true

  UIItem
    id: ball
    size: 20 20
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 2
    margin-right: 2
    virtual: true
    phantom: true

  UIWidget
    id: lockIcon
    size: 12 14
    anchors.top: parent.top
    anchors.right: ball.left
    margin-top: 3
    margin-right: 3
    image-source: /modules/game_storage/icons/codex_lock
    visible: false
    phantom: true

  UIWidget
    id: genderIcon
    size: 11 11
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 17
    margin-left: 5
    phantom: true

  UIWidget
    id: starsCol
    size: 8 44
    anchors.top: genderIcon.bottom
    anchors.left: parent.left
    margin-top: 3
    margin-left: 6
    phantom: true
    layout:
      type: verticalBox
      spacing: 1

  Label
    id: tagLabel
    anchors.top: ball.bottom
    anchors.right: parent.right
    margin-top: 1
    margin-right: 3
    font: verdana-11px-rounded
    color: #5fe0ff
    text-auto-resize: true
    phantom: true

  Label
    id: nameLabel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: portrait.bottom
    margin-left: 3
    margin-right: 3
    height: 13
    text-align: center
    font: verdana-11px-rounded
    color: #ffffff
    phantom: true

  Label
    id: levelLabel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: nameLabel.bottom
    margin-left: 3
    margin-right: 3
    height: 13
    text-align: center
    font: verdana-11px-rounded
    color: #8fa7c4
    phantom: true

  UIWidget
    id: hpBg
    height: 4
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 6
    margin-right: 6
    margin-bottom: 4
    background-color: #0c1828
    phantom: true

  UIWidget
    id: hpFill
    height: 4
    width: 0
    anchors.left: hpBg.left
    anchors.top: hpBg.top
    background-color: #5fd35f
    phantom: true

PCItemSlot < UIWidget
