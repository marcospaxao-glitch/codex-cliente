UIWindow
  id: pcWindow
  size: 1000 730
  anchors.centerIn: parent
  background-color: #00000000
  border-width: 0
  image-source: /modules/game_storage/images/st_card
  image-border: 12
  focusable: true
  visible: false

  UIWidget
    id: headerBar
    size: 4 18
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 14
    margin-left: 16
    background-color: #f2c400
    visible: false
    phantom: true

  Label
    id: titleLabel
    text: PC
    anchors.verticalCenter: headerBar.verticalCenter
    anchors.left: parent.left
    margin-left: 18
    font: sans-bold-16px
    color: #ffd84a
    text-auto-resize: true
    phantom: true

  Label
    id: summaryLabel
    anchors.verticalCenter: headerBar.verticalCenter
    anchors.left: titleLabel.right
    margin-left: 14
    font: verdana-11px-rounded
    color: #8fa7c4
    text-auto-resize: true
    phantom: true

  UIButton
    id: closeButton
    text: X
    size: 26 26
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 9
    margin-right: 12
    font: verdana-11px-antialised
    color: #ffffff
    image-source: /modules/game_storage/images/st_btn_red
    image-border: 9
    @onClick: modules.game_storage.hide()

    $pressed:
      image-source: /modules/game_storage/images/st_btn_red_on

  Panel
    id: tabsPanel
    height: 32
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 42
    margin-left: 12
    margin-right: 12
    layout:
      type: horizontalBox
      spacing: 8

  Panel
    id: subTabsPanel
    height: 66
    anchors.top: tabsPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    margin-left: 12
    margin-right: 12
    layout:
      type: grid
      cell-size: 190 30
      cell-spacing: 6
      num-columns: 5
      flow: true

  ScrollablePanel
    id: contentPanel
    anchors.top: subTabsPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 6
    margin-left: 12
    margin-right: 12
    margin-bottom: 12
    image-source: /modules/game_storage/images/st_card
    image-border: 12
    padding: 4
    vertical-scrollbar: pcScroll

    Panel
      id: contentInner
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 630

      PCButton
        id: prevButton
        text: <
        size: 28 24
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 8
