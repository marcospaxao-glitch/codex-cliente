PCTabHeader < UIWidget
  height: 20
  phantom: true

  Label
    id: title
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-left: 6
    margin-bottom: 3
    font: verdana-11px-rounded
    color: #f2c400
    text-auto-resize: true
    phantom: true

  UIWidget
    id: line
    height: 1
    anchors.left: title.right
    anchors.right: parent.right
    anchors.verticalCenter: title.verticalCenter
    margin-left: 6
    margin-right: 4
    background-color: #1d3557
    phantom: true

PCTab < UIButton
  height: 28
  font: verdana-11px-rounded
  color: #8fa7c4
  text-align: left
  text-offset: 36 0
  background-color: #00000000
  border-width: 0
  image-source: /modules/game_storage/images/st_vazio
  image-border: 8

  $hover !on:
    color: #ffffff
    image-source: /modules/game_storage/images/st_btn_blue_on

  $on:
    color: #ffe27a
    image-source: /modules/game_storage/images/st_cidade_sel

  UIWidget
    id: marker
    width: 3
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    background-color: #00000000
    phantom: true

  UIWidget
    id: iconBg
    size: 26 26
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    background-color: #00000000
    phantom: true

  UIItem
    id: icon
    size: 24 24
    anchors.centerIn: iconBg
    virtual: true
    phantom: true

  UIWidget
    id: iconImage
    size: 24 24
    anchors.centerIn: iconBg
    phantom: true
    visible: false

  Label
    id: countLabel
    size: 34 16
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 5
    text-align: center
    font: verdana-11px-rounded
    color: #dce8f5
    image-source: /modules/game_storage/images/st_campo
    image-border: 6
    phantom: true

