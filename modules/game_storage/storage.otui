PCMarketRow < UIWidget
  height: 42
  background-color: #07101c
  border-width: 1
  border-color: #16294a

  $hover:
    border-color: #2b4a75

  UIWidget
    id: slot
    size: 36 36
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    background-color: #0c1828
    border-width: 1
    border-color: #1d3557
    phantom: true

  UIItem
    id: icon
    size: 32 32
    anchors.centerIn: slot
    virtual: true
    phantom: true

  UIWidget
    id: portrait
    size: 34 34
    anchors.centerIn: slot
    image-size: 34 34
    phantom: true

  Label
    id: nameLabel
    anchors.top: parent.top
    anchors.left: slot.right
    anchors.right: priceLabel.left
    margin-top: 5
    margin-left: 8
    margin-right: 6
    height: 14
    font: verdana-11px-rounded
    color: #ffffff
    phantom: true

  Label
    id: infoLabel
    anchors.top: nameLabel.bottom
    anchors.left: nameLabel.left
    anchors.right: priceLabel.left
    margin-top: 2
    margin-right: 6
    height: 14
    font: verdana-11px-rounded
    color: #6f86a8
    phantom: true

  UIButton
    id: actionButton
    size: 80 24
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    font: verdana-11px-rounded
    color: #dce8f5
    background-color: #1d5a31
    border-width: 1
    border-color: #5fd35f

    $hover:
      color: #ffffff
      background-color: #277a42

    $disabled:
      color: #3a4c64
      background-color: #0c1828
      border-color: #142238

  TextEdit
    id: qtyEdit
    size: 56 22
    anchors.right: actionButton.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    font: verdana-11px-antialised
    color: #0a1320
    background-color: #a2a2a2
    selection-color: #ffffff
    selection-background-color: #2b5a8a
    text-align: center
    max-length: 7

  Label
    id: priceLabel
    width: 170
    height: 24
    anchors.right: qtyEdit.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    text-align: right
    padding: 0 8 0 8
    font: verdana-11px-rounded
    color: #f2c400
    phantom: true

