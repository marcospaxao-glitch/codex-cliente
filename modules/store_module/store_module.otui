StoreGoldButton < UIButton
  height: 24
  font: verdana-11px-antialised
  color: #1a1200
  background-color: #f2c400
  border-width: 1
  border-color: #ffe27a

  $hover:
    background-color: #ffd633

  $disabled:
    color: #6f86a8
    background-color: #101f3e
    border-color: #24415f

StoreDarkButton < UIButton
  height: 24
  font: verdana-11px-rounded
  color: #dce8f5
  background-color: #101f3e
  border-width: 1
  border-color: #24415f

  $hover:
    color: #ffffff
    background-color: #1a3058

StoreEdit < TextEdit
  height: 22
  font: verdana-11px-antialised
  color: #0a1320
  background-color: #c8c8c8
  selection-color: #ffffff
  selection-background-color: #2b5a8a

StoreCategory < UIButton
  height: 40
  font: verdana-11px-rounded
  color: #dce8f5
  text-align: left
  text-offset: 46 0
  icon-rect: 6 4 32 32
  background-color: #0c1828
  border-width: 1
  border-color: #1d3557

  $hover:
    background-color: #142a4a

  $on:
    color: #f2c400
    background-color: #1a2f52
    border-color: #f2c400

StoreCard < UIButton
  size: 112 136
  background-color: #0c1828
  border-width: 1
  border-color: #1d3557

  $hover:
    background-color: #142a4a
    border-color: #f2c400

  Label
    id: name
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 5 4 0 4
    height: 28
    text-wrap: true
    text-align: center
    font: verdana-11px-rounded
    color: #ffffff
    phantom: true

  UIWidget
    id: picture
    size: 88 62
    anchors.top: name.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    image-fixed-ratio: true
    phantom: true

  Label
    id: price
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 8
    height: 16
    text-align: center
    font: verdana-11px-rounded
    color: #f2c400
    phantom: true

  Label
    id: oldPrice
    anchors.bottom: price.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 13
    text-align: center
    font: verdana-11px-antialised
    color: #6f86a8
    visible: false
    phantom: true

  Label
    id: promo
    anchors.top: parent.top
    anchors.left: parent.left
    margin: 2 0 0 2
    padding: 1 3 1 3
    font: verdana-11px-rounded
    color: #ffffff
    background-color: #c62828
    text-auto-resize: true
    visible: false
    phantom: true

  Label
    id: top
    text: TOP
    anchors.top: parent.top
    anchors.left: parent.left
    margin: 2 0 0 2
    padding: 1 3 1 3
    font: verdana-11px-rounded
    color: #1a1200
    background-color: #f2c400
    text-auto-resize: true
    visible: false
    phantom: true

  Label
    id: owned
    text: JA TEM
    anchors.top: parent.top
    anchors.right: parent.right
    margin: 2 2 0 0
    font: verdana-11px-rounded
    color: #5fd35f
    text-auto-resize: true
    visible: false
    phantom: true

StoreHistRow < UIWidget
  height: 20
  background-color: #0c1828
  phantom: true

  Label
    id: date
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    width: 110
    font: verdana-11px-antialised
    color: #8fa7c4

  Label
    id: name
    anchors.left: date.right
    anchors.right: price.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    font: verdana-11px-antialised
    color: #dce8f5

  Label
    id: price
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    width: 80
    text-align: right
    font: verdana-11px-rounded
    color: #f2c400

StorePanel < UIWidget
  background-color: #0a1320
  border-width: 1
  border-color: #f2c400
  visible: false

UIWindow
  id: storeWindow
  size: 820 560
  anchors.centerIn: parent
  background-color: #0a1320
  border-width: 1
  border-color: #f2c400
  focusable: true
  draggable: true
  visible: false
  @onEscape: modules.store_module.hide()

  UIWidget
    id: headerBar
    size: 4 18
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 14
    margin-left: 16
    background-color: #f2c400
    phantom: true

  Label
    id: titleLabel
    text: LOJA CODEX
    anchors.verticalCenter: headerBar.verticalCenter
    anchors.left: headerBar.right
    margin-left: 8
    font: verdana-11px-rounded
    color: #f2c400
    text-auto-resize: true
    phantom: true

  UIButton
    id: closeButton
    text: X
    size: 24 22
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 12
    margin-right: 14
    font: verdana-11px-rounded
    color: #dce8f5
    background-color: #101f3e
    border-width: 1
    border-color: #24415f
    @onClick: modules.store_module.hide()

    $hover:
      color: #ffffff
      background-color: #7a1f1f
      border-color: #e04848

  StoreDarkButton
    id: transferButton
    text: Transferir
    width: 90
    anchors.verticalCenter: closeButton.verticalCenter
    anchors.right: closeButton.left
    margin-right: 10

  StoreDarkButton
    id: historyButton
    text: Historico
    width: 80
    anchors.verticalCenter: closeButton.verticalCenter
    anchors.right: transferButton.left
    margin-right: 6

  StoreGoldButton
    id: getButton
    text: Comprar Donate
    width: 120
    anchors.verticalCenter: closeButton.verticalCenter
    anchors.right: historyButton.left
    margin-right: 6

  Label
    id: balanceLabel
    text: Donate: ...
    anchors.verticalCenter: closeButton.verticalCenter
    anchors.right: getButton.left
    margin-right: 14
    font: verdana-11px-rounded
    color: #f2c400
    text-auto-resize: true

  ScrollablePanel
    id: categoryList
    anchors.top: headerBar.bottom
    anchors.left: parent.left
    anchors.bottom: statusLabel.top
    width: 180
    margin-top: 14
    margin-left: 16
    margin-bottom: 8
    layout:
      type: verticalBox
      spacing: 4

  UIWidget
    id: banner
    anchors.top: categoryList.top
    anchors.left: categoryList.right
    anchors.right: parent.right
    height: 76
    margin-left: 12
    margin-right: 16
    background-color: #0c1828
    border-width: 1
    border-color: #1d3557

    UIWidget
      id: bannerImage
      size: 64 64
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      image-fixed-ratio: true
      phantom: true

    Label
      id: bannerTitle
      anchors.top: parent.top
      anchors.left: bannerImage.right
      anchors.right: parent.right
      margin: 12 10 0 12
      height: 16
      font: verdana-11px-rounded
      color: #f2c400

    Label
      id: bannerText
      anchors.top: bannerTitle.bottom
      anchors.left: bannerImage.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 4 10 6 12
      text-wrap: true
      font: verdana-11px-rounded
      color: #8fa7c4

  Label
    id: searchHint
    text: Buscar:
    anchors.top: banner.bottom
    anchors.left: banner.left
    margin-top: 12
    font: verdana-11px-rounded
    color: #dce8f5
    text-auto-resize: true

  StoreEdit
    id: searchEdit
    width: 220
    anchors.verticalCenter: searchHint.verticalCenter
    anchors.left: searchHint.right
    margin-left: 8

  Label
    id: countLabel
    anchors.verticalCenter: searchHint.verticalCenter
    anchors.right: banner.right
    font: verdana-11px-rounded
    color: #6f86a8
    text-auto-resize: true

  ScrollablePanel
    id: productList
    anchors.top: searchEdit.bottom
    anchors.left: banner.left
    anchors.right: productScroll.left
    anchors.bottom: statusLabel.top
    margin-top: 10
    margin-right: 4
    margin-bottom: 8
    vertical-scrollbar: productScroll
    layout:
      type: grid
      cell-size: 112 136
      cell-spacing: 6
      flow: true

  VerticalScrollBar
    id: productScroll
    width: 12
    anchors.top: searchEdit.bottom
    anchors.bottom: statusLabel.top
    anchors.right: parent.right
    margin-top: 10
    margin-bottom: 8
    margin-right: 16
    step: 71
    pixels-scroll: true

  Label
    id: statusLabel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 0 16 10 16
    height: 16
    font: verdana-11px-rounded
    color: #8fa7c4

  StorePanel
    id: confirmPanel
    size: 540 320
    anchors.centerIn: parent

    UIWidget
      id: previewBox
      size: 170 190
      anchors.top: parent.top
      anchors.left: parent.left
      margin: 16 0 0 16
      background-color: #0c1828
      border-width: 1
      border-color: #1d3557

      UIWidget
        id: confirmImage
        size: 130 110
        anchors.centerIn: parent
        image-fixed-ratio: true
        phantom: true

      UICreature
        id: confirmCreature
        size: 150 150
        anchors.centerIn: parent
        visible: false
        phantom: true

      Label
        id: previewHint
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-bottom: 4
        height: 14
        text-align: center
        font: verdana-11px-antialised
        color: #6f86a8
        phantom: true

    Label
      id: confirmTitle
      anchors.top: parent.top
      anchors.left: previewBox.right
      anchors.right: parent.right
      margin: 18 16 0 16
      height: 18
      font: verdana-11px-rounded
      color: #f2c400

    Label
      id: confirmBadge
      anchors.top: confirmTitle.bottom
      anchors.left: confirmTitle.left
      margin-top: 2
      padding: 1 4 1 4
      font: verdana-11px-rounded
      color: #ffffff
      background-color: #c62828
      text-auto-resize: true
      visible: false

    Label
      id: confirmText
      anchors.top: confirmBadge.bottom
      anchors.left: confirmTitle.left
      anchors.right: parent.right
      margin: 8 16 0 0
      height: 70
      text-wrap: true
      font: verdana-11px-antialised
      color: #dce8f5

    Label
      id: unitLabel
      anchors.top: confirmText.bottom
      anchors.left: confirmTitle.left
      margin-top: 6
      font: verdana-11px-rounded
      color: #8fa7c4
      text-auto-resize: true

    Label
      id: qtyLabel
      text: Quantidade:
      anchors.top: unitLabel.bottom
      anchors.left: confirmTitle.left
      margin-top: 12
      font: verdana-11px-rounded
      color: #dce8f5
      text-auto-resize: true

    StoreDarkButton
      id: qtyMinus
      text: -
      size: 24 22
      anchors.verticalCenter: qtyLabel.verticalCenter
      anchors.left: qtyLabel.right
      margin-left: 8

    StoreEdit
      id: qtyEdit
      width: 40
      anchors.verticalCenter: qtyLabel.verticalCenter
      anchors.left: qtyMinus.right
      margin-left: 4
      text-align: center

    StoreDarkButton
      id: qtyPlus
      text: +
      size: 24 22
      anchors.verticalCenter: qtyLabel.verticalCenter
      anchors.left: qtyEdit.right
      margin-left: 4

    StoreDarkButton
      id: qty5
      text: 5x
      size: 34 22
      anchors.verticalCenter: qtyLabel.verticalCenter
      anchors.left: qtyPlus.right
      margin-left: 10

    StoreDarkButton
      id: qty10
      text: 10x
      size: 34 22
      anchors.verticalCenter: qtyLabel.verticalCenter
      anchors.left: qty5.right
      margin-left: 4

    StoreDarkButton
      id: qty25
      text: 25x
      size: 34 22
      anchors.verticalCenter: qtyLabel.verticalCenter
      anchors.left: qty10.right
      margin-left: 4

    Label
      id: confirmPrice
      anchors.top: qtyLabel.bottom
      anchors.left: confirmTitle.left
      anchors.right: parent.right
      margin: 14 16 0 0
      height: 16
      font: verdana-11px-rounded
      color: #f2c400

    Label
      id: confirmAfter
      anchors.top: confirmPrice.bottom
      anchors.left: confirmTitle.left
      anchors.right: parent.right
      margin: 2 16 0 0
      height: 16
      font: verdana-11px-antialised
      color: #8fa7c4

    StoreGoldButton
      id: confirmBuy
      text: Comprar
      size: 150 30
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin: 0 16 16 0

    StoreDarkButton
      id: confirmCancel
      text: Fechar
      size: 100 30
      anchors.bottom: parent.bottom
      anchors.right: confirmBuy.left
      margin: 0 8 16 0

  StorePanel
    id: historyPanel
    size: 520 380
    anchors.centerIn: parent

    Label
      id: historyTitle
      text: HISTORICO DE COMPRAS
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 14 14 0 14
      height: 16
      text-align: center
      font: verdana-11px-rounded
      color: #f2c400

    ScrollablePanel
      id: historyList
      anchors.top: historyTitle.bottom
      anchors.left: parent.left
      anchors.right: historyScroll.left
      anchors.bottom: historyClose.top
      margin: 10 4 10 16
      vertical-scrollbar: historyScroll
      layout:
        type: verticalBox
        spacing: 2

    VerticalScrollBar
      id: historyScroll
      width: 12
      anchors.top: historyTitle.bottom
      anchors.bottom: historyClose.top
      anchors.right: parent.right
      margin-top: 10
      margin-bottom: 10
      margin-right: 14
      step: 20
      pixels-scroll: true

    StoreDarkButton
      id: historyClose
      text: Fechar
      width: 120
      anchors.bottom: parent.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-bottom: 14

  StorePanel
    id: transferPanel
    size: 360 210
    anchors.centerIn: parent

    Label
      id: transferTitle
      text: TRANSFERIR DONATE
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 14 14 0 14
      height: 16
      text-align: center
      font: verdana-11px-rounded
      color: #f2c400

    Label
      id: transferInfo
      text: O Donate vai para o PokeBank de quem receber.
      anchors.top: transferTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 8 16 0 16
      height: 16
      text-align: center
      font: verdana-11px-rounded
      color: #8fa7c4

    Label
      id: transferNameLabel
      text: Personagem:
      anchors.top: transferInfo.bottom
      anchors.left: parent.left
      margin: 16 0 0 20
      width: 90
      font: verdana-11px-rounded
      color: #dce8f5

    StoreEdit
      id: transferName
      anchors.verticalCenter: transferNameLabel.verticalCenter
      anchors.left: transferNameLabel.right
      anchors.right: parent.right
      margin-right: 20

    Label
      id: transferAmountLabel
      text: Quantidade:
      anchors.top: transferNameLabel.bottom
      anchors.left: parent.left
      margin: 18 0 0 20
      width: 90
      font: verdana-11px-rounded
      color: #dce8f5

    StoreEdit
      id: transferAmount
      anchors.verticalCenter: transferAmountLabel.verticalCenter
      anchors.left: transferAmountLabel.right
      width: 90

    StoreGoldButton
      id: transferSend
      text: Enviar
      width: 120
      anchors.bottom: parent.bottom
      anchors.right: parent.horizontalCenter
      margin-bottom: 14
      margin-right: 4

    StoreDarkButton
      id: transferCancel
      text: Cancelar
      width: 120
      anchors.bottom: parent.bottom
      anchors.left: parent.horizontalCenter
      margin-bottom: 14
      margin-left: 4
