TMPokeButton < UIWidget
  size: 112 40
  background-color: #0c1828
  border-width: 1
  border-color: #1d3557
  focusable: false
  $hover:
    background-color: #12223a
  $on:
    border-color: #f2c400
    background-color: #182c48

  UICreature
    id: creature
    size: 36 36
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    phantom: true

  Label
    id: name
    anchors.left: creature.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 5
    margin-left: 3
    height: 13
    font: verdana-11px-rounded
    color: #ffffff
    text-auto-resize: false
    phantom: true

  Label
    id: info
    anchors.left: name.left
    anchors.right: parent.right
    anchors.top: name.bottom
    height: 13
    font: verdana-11px-rounded
    color: #8fa7c4
    text-auto-resize: false
    phantom: true

TMMoveRow < UIWidget
  height: 26
  background-color: #0c1828
  border-width: 1
  border-color: #16294a
  focusable: false

  UIWidget
    id: icon
    size: 20 20
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    phantom: true

  Label
    id: name
    anchors.left: icon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    width: 160
    font: verdana-11px-rounded
    color: #ffffff
    text-auto-resize: false
    phantom: true

  Label
    id: info
    anchors.left: name.right
    anchors.verticalCenter: parent.verticalCenter
    width: 150
    font: verdana-11px-rounded
    color: #8fa7c4
    text-auto-resize: false
    phantom: true

  Button
    id: action
    size: 76 20
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4

TMWindow < UIWindow
  size: 540 470
  anchors.centerIn: parent
  background-color: #0a1320
  border-width: 1
  border-color: #f2c400
  focusable: true
  draggable: true
  @onEscape: modules.game_teramoves.closeWindow()

  UIWidget
    id: headerBar
    size: 4 18
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 12
    margin-left: 12
    background-color: #f2c400
    phantom: true

  Label
    text: GOLPES TERA
    anchors.verticalCenter: headerBar.verticalCenter
    anchors.left: headerBar.right
    margin-left: 8
    font: verdana-11px-rounded
    color: #f2c400
    text-auto-resize: true
    phantom: true

  Label
    id: costLabel
    anchors.verticalCenter: headerBar.verticalCenter
    anchors.right: closeButton.left
    margin-right: 10
    font: verdana-11px-rounded
    color: #c9d6e6
    text-auto-resize: true
    phantom: true

  Button
    id: closeButton
    text: X
    size: 22 20
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 10
    margin-right: 10
    @onClick: modules.game_teramoves.closeWindow()

  Panel
    id: teamPanel
    anchors.top: headerBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 12 12 0 12
    height: 84
    layout:
      type: grid
      cell-size: 168 40
      cell-spacing: 4
      flow: true

  Label
    id: infoLabel
    anchors.top: teamPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 8 12 0 12
    height: 28
    font: verdana-11px-rounded
    color: #c9d6e6
    text-wrap: true
    text-auto-resize: false

  Label
    text: APRENDIDOS
    anchors.top: infoLabel.bottom
    anchors.left: parent.left
    margin: 6 12 0 12
    font: verdana-11px-rounded
    color: #f2c400
    text-auto-resize: true

  Panel
    id: learnedPanel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 4 12 0 12
    height: 56
    layout:
      type: verticalBox
      spacing: 2

  Label
    text: DISPONIVEIS (tipo do Tera)
    anchors.top: learnedPanel.bottom
    anchors.left: parent.left
    margin: 8 12 0 12
    font: verdana-11px-rounded
    color: #f2c400
    text-auto-resize: true

  ScrollablePanel
    id: movesPanel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: movesScroll.left
    anchors.bottom: parent.bottom
    margin: 4 0 12 12
    vertical-scrollbar: movesScroll
    layout:
      type: verticalBox
      spacing: 2

  VerticalScrollBar
    id: movesScroll
    anchors.top: movesPanel.top
    anchors.bottom: movesPanel.bottom
    anchors.right: parent.right
    margin-right: 12
    step: 28
    pixels-scroll: true
