BMButton < UIButton
  height: 24
  font: verdana-11px-antialised
  color: #dce8f5
  background-color: #101f3e
  border-width: 1
  border-color: #24415f
  $hover:
    color: #ffffff
    background-color: #1a3058
  $disabled:
    color: #4d6380

BMLine < Label
  height: 16
  font: verdana-11px-antialised
  color: #dce8f5

UIWindow
  id: boostWindow
  size: 420 380
  anchors.centerIn: parent
  background-color: #0a1320
  border-width: 1
  border-color: #f2c400
  focusable: true
  draggable: true
  visible: false

  UIWidget
    id: headerBar
    size: 4 18
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 14
    margin-left: 16
    background-color: #f2c400
    phantom: true

  Label
    id: titleLabel
    text: MAQUINA DE BOOST
    anchors.verticalCenter: headerBar.verticalCenter
    anchors.left: headerBar.right
    margin-left: 8
    font: verdana-11px-antialised
    color: #f2c400
    text-auto-resize: true
    phantom: true

  UIButton
    id: closeButton
    text: X
    size: 24 22
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 12
    margin-right: 14
    font: verdana-11px-antialised
    color: #dce8f5
    background-color: #101f3e
    border-width: 1
    border-color: #24415f
    @onClick: modules.game_boostmachine.hide()

  UIWidget
    id: pokeBg
    size: 72 72
    anchors.top: headerBar.bottom
    anchors.left: parent.left
    margin-top: 14
    margin-left: 18
    background-color: #07101c
    border-width: 1
    border-color: #1d3557

  UICreature
    id: poke
    size: 64 64
    anchors.centerIn: pokeBg
    phantom: true

  Label
    id: pokeName
    anchors.top: pokeBg.top
    anchors.left: pokeBg.right
    anchors.right: parent.right
    margin-left: 12
    margin-right: 18
    height: 18
    font: verdana-11px-antialised
    color: #ffffff

  BMLine
    id: boostNow
    anchors.top: pokeName.bottom
    anchors.left: pokeName.left
    anchors.right: pokeName.right
    margin-top: 4

  UIItem
    id: stoneItem
    size: 32 32
    anchors.top: boostNow.bottom
    anchors.left: pokeName.left
    margin-top: 2
    virtual: true

  BMLine
    id: stoneInfo
    anchors.verticalCenter: stoneItem.verticalCenter
    anchors.left: stoneItem.right
    anchors.right: pokeName.right
    margin-left: 6

  BMButton
    id: minus
    text: -
    width: 34
    anchors.top: pokeBg.bottom
    anchors.left: parent.left
    margin-top: 18
    margin-left: 18

  Label
    id: targetLabel
    anchors.verticalCenter: minus.verticalCenter
    anchors.left: minus.right
    width: 110
    text-align: center
    font: verdana-11px-antialised
    color: #f2c400

  BMButton
    id: plus
    text: +
    width: 34
    anchors.verticalCenter: minus.verticalCenter
    anchors.left: targetLabel.right

  BMButton
    id: plus5
    text: +5
    width: 44
    anchors.verticalCenter: minus.verticalCenter
    anchors.left: plus.right
    margin-left: 6

  BMButton
    id: maxButton
    text: Maximo
    width: 74
    anchors.verticalCenter: minus.verticalCenter
    anchors.left: plus5.right
    margin-left: 6

  UIWidget
    id: calcBox
    anchors.top: minus.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 14
    margin-left: 18
    margin-right: 18
    height: 132
    background-color: #0c1828
    border-width: 1
    border-color: #1d3557

  BMLine
    id: calc1
    anchors.top: calcBox.top
    anchors.left: calcBox.left
    anchors.right: calcBox.right
    margin: 10 10 0 10

  BMLine
    id: calc2
    anchors.top: calc1.bottom
    anchors.left: calc1.left
    anchors.right: calc1.right
    margin-top: 6

  BMLine
    id: calc3
    anchors.top: calc2.bottom
    anchors.left: calc1.left
    anchors.right: calc1.right
    margin-top: 6

  BMLine
    id: calc4
    anchors.top: calc3.bottom
    anchors.left: calc1.left
    anchors.right: calc1.right
    margin-top: 6

  BMLine
    id: calc5
    anchors.top: calc4.bottom
    anchors.left: calc1.left
    anchors.right: calc1.right
    margin-top: 6
    color: #8fa7c4

  UIButton
    id: confirmButton
    text: Confirmar
    height: 28
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 16
    margin-right: 18
    width: 130
    font: verdana-11px-antialised
    color: #1a1200
    background-color: #f2c400
    border-width: 1
    border-color: #ffe27a
    $hover:
      background-color: #ffd633
    $disabled:
      color: #8fa7c4
      background-color: #101f3e
      border-color: #24415f

  BMButton
    id: cancelButton
    text: Cancelar
    width: 100
    height: 28
    anchors.verticalCenter: confirmButton.verticalCenter
    anchors.right: confirmButton.left
    margin-right: 8
    @onClick: modules.game_boostmachine.hide()
